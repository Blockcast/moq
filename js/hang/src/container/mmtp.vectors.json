{
	"version": 1,
	"description": "MMTP receive vectors for a MoQ track carrying one MMTP packet per object (hang container kind 'mmtp'). Hand-authored from ISO/IEC 23008-1:2023 Figure 8 (MMTP header) and 9.2.3 (MPU payload header, timed MFU DU header); every packet is listed field by field. Not generated by any implementation under test.",
	"conventions": [
		"Integers are big-endian.",
		"timestampUs is the MoQ frame timestamp in microseconds; null means an untimed frame.",
		"An error case stops at the first frame that throws; 'gate' is libmmt's MFU rejection gate or reassembly error code when one applies."
	],
